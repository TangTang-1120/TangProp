# ============================================================
# TangProp — 环境变量模板
# ============================================================
# 复制此文件为 .env 并填入你的配置
# cp .env.example .env

# ── 模型 API Key ──
GROQ_API_KEY=
SILICONFLOW_API_KEY=
ZHIPU_API_KEY=
BAILIAN_API_KEY=
VOLCENGINE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUNYUAN_API_KEY=

# ── Server ──
PORT=8080

# ── 腾讯云 SMS（不填则进入开发模式，验证码返回到 API 响应中）──
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=TangProp
TENCENT_SMS_TEMPLATE_ID=

# ── 邮箱 SMTP（不填则进入开发模式）──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TangProp
