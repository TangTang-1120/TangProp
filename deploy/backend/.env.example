# ============================================================
# WorkBuddy Backend — 环境变量
# ============================================================
# 复制此文件为 .env 并填入你的 API Key:
#   cp .env.example .env

# ── 推荐: DeepSeek（便宜、中文好、支持 function calling）──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ── OpenAI ──
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Anthropic Claude ──
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── 腾讯混元 ──
HUNYUAN_API_KEY=your-hunyuan-api-key-here

# Pollinations.ai — 完全免费文生图（flux 免 Key，可选 POLLINATIONS_API_KEY 解锁更多模型）
# 注册（可选）: https://enter.pollinations.ai
POLLINATIONS_API_KEY=

# ── Server ──
PORT=8080
